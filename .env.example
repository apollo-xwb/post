# PayFast Gateway Configuration (required for online checkout)
VITE_PAYFAST_MERCHANT_ID=
VITE_PAYFAST_MERCHANT_KEY=
VITE_PAYFAST_PASSPHRASE=
VITE_PAYFAST_SANDBOX=true
# Public HTTPS URL for PayFast ITN (e.g. https://pnx.lutho.app/api/payfast/itn via server/payfast-itn.mjs)
VITE_PAYFAST_NOTIFY_URL=

# PayFast ITN server (server/payfast-itn.mjs) — never commit real values
PAYFAST_PASSPHRASE=
PAYFAST_MERCHANT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIRESTORE_DATABASE_ID=

# IQ Retail REST API (Port 8080)
VITE_IQ_BASE_URL=https://qa1.iqsoftware.co.za:8080/
VITE_IQ_COMPANY_ID=POSTNET-BRANCH-001
VITE_IQ_API_KEY=
